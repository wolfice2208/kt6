# ============================ Приложение ============================
APP_NAME=Протокол
APP_VERSION=2.0.0
DEBUG=false
API_PREFIX=/api

# ======================= Источник данных ============================
# mock — синтетические данные, работает без сети (страховка на защите);
# demo — официальный demo API STALZONE (dapi), публичные токены;
# live — production API (eapi), нужен токен от EXBO.
DATA_SOURCE=mock
STALZONE_REGION=RU
STALZONE_API_BASE=https://eapi.stalcraft.net
STALZONE_DEMO_BASE=https://dapi.stalzone.com
STALZONE_APP_TOKEN=
STALZONE_CLIENT_ID=
STALZONE_CLIENT_SECRET=
STALZONE_SCOPE=
STALZONE_TOKEN_URL=
STALZONE_TIMEOUT_SECONDS=15

# ============================== Сеть ================================
# Список origin'ов фронтенда через запятую (без пробелов не обязательно).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================ База данных ===========================
# Пусто — SQLite в backend/data/app.db.
DATABASE_URL=
DATA_DIR=

# ========================= Аутентификация ===========================
# Секрет подписи JWT. На проде обязательно переопределить!
JWT_SECRET=protokol-local-development-secret-do-not-use-in-prod
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=240
# Демо-данные при первом запуске (demo / demo12345, student / student123).
SEED_DEMO_USERS=true
SEED_DEMO_TRADES=true

# ============================== Каталог =============================
SEED_ITEMS_LIMIT=120
CATALOG_LOOKUP_LIMIT=300

# ======================= Экономика аукциона =========================
# Комиссия аукциона при продаже (0.05 = 5%).
FEE_PCT=0.05
DEFAULT_MIN_MARGIN_PCT=15
HISTORY_WINDOW_DAYS=7
COMPETITION_TOLERANCE=0.05

# ============================ Ingestion =============================
# false — один обход при старте: цифры в ленте, карточке и калькуляторе
# остаются согласованными (удобно на защите).
# true  — воркер обходит предметы по кругу и обновляет лоты вживую.
ENABLE_INGESTION=false
SCAN_INTERVAL_SECONDS=45
MAX_REQUESTS_PER_MINUTE=180
MAX_ITEMS_PER_SCAN=120
HISTORY_REFRESH_SECONDS=180
HTTP_RETRIES=3
